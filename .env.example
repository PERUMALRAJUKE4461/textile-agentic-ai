RPM_MINIMUM=600
TEMPERATURE_MAXIMUM=65
VIBRATION_MAXIMUM=3
MOTOR_CURRENT_MAXIMUM=15
WARP_TENSION_MINIMUM=25
WARP_TENSION_MAXIMUM=35
WEFT_TENSION_MINIMUM=20
WEFT_TENSION_MAXIMUM=30
EFFICIENCY_MINIMUM=85
DEFECT_RATE_MAXIMUM=2
